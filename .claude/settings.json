{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(find:*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)",
      "Skill(*)",
      "TaskCreate(*)",
      "TaskUpdate(*)",
      "TaskList(*)",
      "TaskGet(*)",
      "TaskStop(*)",
      "TaskOutput(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(format *)",
      "Bash(mkfs *)",
      "Bash(fdisk *)",
      "Bash(dd if=*of=/dev/*)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(git push * origin main)",
      "Bash(git push * origin master)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(*.pem)",
      "Read(~/.ssh/**)"
    ],
    "defaultMode": "dontAsk"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-git-push-hook.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
